{
  "name": "@kepello/nodegraph-analyzer-markdown",
  "version": "0.2.3",
  "description": "Markdown analyzer subprocess for @kepello/nodegraph-analysis. Walks markdown via remark and emits structural elements (sections, code blocks, tables), cross-document link edges, frontmatter, and HTML comments adjacent to headings.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "nodegraph-analyzer-markdown": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "default": "./dist/cli.js"
    }
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --import tsx 'src/**/*.test.ts'",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@kepello/nodegraph-analysis": "^0.10.0"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "js-yaml": "^4.1.0",
    "mdast": "^3.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.0"
  },
  "devDependencies": {
    "@kepello/nodegraph-analysis": "file:../nodegraph-analysis",
    "@types/js-yaml": "^4.0.0",
    "@types/mdast": "^4.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kepello/nodegraph-analyzer-markdown.git"
  },
  "license": "MIT",
  "author": "Carl Lance"
}
